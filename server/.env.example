# Local development defaults
HOST=0.0.0.0
PORT=8765

# Short disconnects keep the same PARDEX room/session for this duration.
SESSION_GRACE_MS=30000

# Persistent social data file. In production, point this to a mounted volume.
# Railway example after mounting a Volume at /data:
# PARDEX_SOCIAL_DATA_PATH=/data/social.json
PARDEX_SOCIAL_DATA_PATH=./data/social.json

# Assigned Godot game-server endpoint for Korsanların Hazinesi rooms.
# Leave empty until the dedicated game server has a public ws/wss address.
KORSAN_GAME_SERVER_URL=

# Connections that do not send a PARDEX hello within this time are closed.
HELLO_TIMEOUT_MS=10000

# Voice relay is off while PARDEX voice is disabled on the client. Set to 1 to enable.
PARDEX_VOICE_RELAY_ENABLED=
