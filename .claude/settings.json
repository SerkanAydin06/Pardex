{
  "model": "sonnet",
  "effortLevel": "medium",
  "env": {
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "4096"
  },
  "permissions": {
    "deny": [
      "Read(.godot/**)",
      "Read(node_modules/**)",
      "Read(server/node_modules/**)",
      "Read(server/data/**)",
      "Read(.git/**)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/*.key)",
      "Read(**/*.pem)"
    ],
    "ask": [
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Bash(rm -rf:*)",
      "Bash(npm publish:*)"
    ]
  }
}
