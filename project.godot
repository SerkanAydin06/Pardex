; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section between []
;   param=value

config_version=5

[application]

config/name="PARDEX"
config/description="Oyunlarınızı tek merkezde toplayan launcher ve online oyun merkezi"
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/icon.png"

[autoload]

PardexIdentityGuard="*res://scripts/online/pardex_identity_guard.gd"
PardexOnline="*res://scripts/online/pardex_online_secure_handoff.gd"
PardexGameLauncher="*res://scripts/online/pardex_game_launcher.gd"
PardexNotifications="*res://scripts/online/pardex_notifications.gd"
PardexPresenceUI="*res://scripts/online/pardex_presence_ui.gd"
PardexTypography="*res://scripts/ui/pardex_typography.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=0
window/size/resizable=true
window/size/window_width_override=1440
window/size/window_height_override=900
window/stretch/mode="disabled"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.025, 0.031, 0.045, 1)
